

!$numsteps = 16;
!for($i=0; $i < $numsteps;$i++){
!$initialPo=0.75;
!$trans = $i;
!$distance = $initialPo- $trans * 0.1;
PLANE: y0 $trans
  Option = ZX Plane
  Y= $distance [m]
  Colour Scale = Linear
  Colour Mode = Variable
  Colour Variable = Velocity
  Range = Local
  Number of Contours = 11
END

!}



